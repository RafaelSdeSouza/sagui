# diffusion_geometry_spectra_toy.R
#
# A self-contained toy example showing how diffusion geometry differs from PCA.
# It uses only base R and stats; no diffusion-map package is required.
set.seed(123)
# -------------------------------------------------------------------------
# 1. Generate a nonlinear one-dimensional sequence of toy spectra
# -------------------------------------------------------------------------
n <- 260
lambda <- seq(5000, 5100, length.out = 320)
s <- seq(0, 1, length.out = n)
theta <- 3 * pi * s
radius <- 0.06 + 0.16 * s
a <- radius * cos(theta)
b <- radius * sin(theta)
gaussian_line <- function(lambda, centre, width) {
exp(-0.5 * ((lambda - centre) / width)^2)
}
X <- matrix(NA_real_, nrow = n, ncol = length(lambda))
for (i in seq_len(n)) {
spectrum <-
1 +
0.01 * (s[i] - 0.5) * (lambda - mean(lambda)) / 50 -
(0.24 + a[i]) * gaussian_line(lambda, 5028, 1.3) -
(0.23 + b[i]) * gaussian_line(lambda, 5052, 1.7) -
(0.18 + 0.6 * (a[i] + b[i])) *
gaussian_line(lambda, 5078, 1.1) +
0.006 * sin(2 * pi * s[i]) *
((lambda - mean(lambda)) / 50)^2 +
rnorm(length(lambda), mean = 0, sd = 0.0025)
X[i, ] <- spectrum
}
# -------------------------------------------------------------------------
# 2. Ordinary PCA
# -------------------------------------------------------------------------
pca_fit <- prcomp(X, center = TRUE, scale. = FALSE)
pca_scores <- pca_fit$x
rho_pca1 <- cor(pca_scores[, 1], s, method = "spearman")
# -------------------------------------------------------------------------
# 3. Diffusion map implemented from scratch
# -------------------------------------------------------------------------
diffusion_map <- function(
X,
k = 10L,
alpha = 1,
diffusion_time = 1,
n_components = 5L
) {
if (!is.matrix(X)) {
X <- as.matrix(X)
}
n <- nrow(X)
if (n < 3L) {
stop("At least three observations are required.")
}
if (k < 2L || k >= n) {
stop("k must satisfy 2 <= k < number of observations.")
}
# Squared Euclidean distances between spectra.
D2 <- as.matrix(dist(X))^2
# A separate copy excludes self-distances when finding neighbours.
D2_for_nn <- D2
diag(D2_for_nn) <- Inf
# Kernel bandwidth: median squared distance to the kth neighbour.
kth_dist2 <- apply(
D2_for_nn,
1,
function(row) sort(row, partial = k)[k]
)
epsilon <- median(kth_dist2)
if (!is.finite(epsilon) || epsilon <= 0) {
stop("Could not determine a positive kernel bandwidth.")
}
# Gaussian affinity.
W <- exp(-D2 / epsilon)
diag(W) <- 0
# Keep only a symmetric k-nearest-neighbour graph.
knn_mask <- matrix(FALSE, nrow = n, ncol = n)
for (i in seq_len(n)) {
neighbours <- order(D2_for_nn[i, ])[seq_len(k)]
knn_mask[i, neighbours] <- TRUE
}
knn_mask <- knn_mask | t(knn_mask)
W[!knn_mask] <- 0
# Density correction. alpha = 1 approximately removes sampling-density bias.
q <- rowSums(W)
if (any(q <= 0)) {
stop("The affinity graph contains isolated observations.")
}
K <- W / (q %o% q)^alpha
# Row sums define the Markov normalization.
d <- rowSums(K)
if (any(d <= 0)) {
stop("The normalized graph contains isolated observations.")
}
# Symmetric matrix similar to the random-walk transition matrix.
A <- K / sqrt(d %o% d)
A <- 0.5 * (A + t(A))
eig <- eigen(A, symmetric = TRUE)
# Right eigenvectors of the row-stochastic diffusion operator.
psi <- sweep(
eig$vectors,
MARGIN = 1,
STATS = sqrt(d),
FUN = "/"
)
# The first eigenvector is the trivial constant mode and is removed.
available <- min(n_components, n - 1L)
keep <- 2:(available + 1L)
coordinates <- sweep(
psi[, keep, drop = FALSE],
MARGIN = 2,
STATS = eig$values[keep]^diffusion_time,
FUN = "*"
)
colnames(coordinates) <- paste0("DC", seq_len(ncol(coordinates)))
list(
coordinates = coordinates,
eigenvalues = eig$values,
affinity = W,
epsilon = epsilon,
degree = d,
k = k,
alpha = alpha,
diffusion_time = diffusion_time
)
}
dm_fit <- diffusion_map(
X = X,
k = 10,
alpha = 1,
diffusion_time = 1,
n_components = 5
)
dc <- dm_fit$coordinates
rho_dc1 <- cor(dc[, 1], s, method = "spearman")
cat("Variance explained by PCA PC1 and PC2:",
sum(pca_fit$sdev[1:2]^2) / sum(pca_fit$sdev^2), "\n")
cat("Spearman correlation between PC1 and latent s:", rho_pca1, "\n")
cat("Spearman correlation between DC1 and latent s:", rho_dc1, "\n")
cat("Diffusion bandwidth epsilon:", dm_fit$epsilon, "\n")
# -------------------------------------------------------------------------
# 4. Plot selected spectra
# -------------------------------------------------------------------------
selected <- round(seq(1, n, length.out = 9))
offset <- 0.12
png(
"diffusion_toy_1_spectra.png",
width = 1600,
height = 1000,
res = 180
)
matplot(
lambda,
t(X[selected, ] + (seq_along(selected) - 1) * offset),
type = "l",
lty = 1,
xlab = "Wavelength",
ylab = "Flux + vertical offset",
main = "Toy nonlinear spectral sequence"
)
legend(
"topright",
legend = sprintf("s = %.2f", s[selected]),
lty = 1,
ncol = 3,
cex = 0.75,
bty = "n"
)
dev.off()
# -------------------------------------------------------------------------
# 5. Plot the PCA embedding
# -------------------------------------------------------------------------
png(
"diffusion_toy_2_pca.png",
width = 1250,
height = 1050,
res = 180
)
plot(
pca_scores[, 1],
pca_scores[, 2],
type = "o",
pch = 16,
cex = 0.45,
xlab = "PC1",
ylab = "PC2",
main = sprintf(
"PCA follows a curved spiral; Spearman(PC1, s) = %.3f",
rho_pca1
)
)
mark_s <- c(0, 0.25, 0.50, 0.75, 1)
mark_i <- round(mark_s * (n - 1)) + 1
text(
pca_scores[mark_i, 1],
pca_scores[mark_i, 2],
labels = sprintf("s=%.2f", mark_s),
pos = 4,
cex = 0.75
)
dev.off()
# -------------------------------------------------------------------------
# 6. Plot a local-neighbour graph in the PCA plane
# -------------------------------------------------------------------------
D2 <- as.matrix(dist(X))^2
diag(D2) <- Inf
shown_k <- 3L
png(
"diffusion_toy_3_local_graph.png",
width = 1250,
height = 1050,
res = 180
)
plot(
pca_scores[, 1],
pca_scores[, 2],
pch = 16,
cex = 0.45,
xlab = "PC1",
ylab = "PC2",
main = "Local spectral-neighbour graph used by diffusion geometry"
)
for (i in seq_len(n)) {
neighbours <- order(D2[i, ])[seq_len(shown_k)]
for (j in neighbours) {
if (i < j) {
segments(
pca_scores[i, 1],
pca_scores[i, 2],
pca_scores[j, 1],
pca_scores[j, 2]
)
}
}
}
points(
pca_scores[, 1],
pca_scores[, 2],
pch = 16,
cex = 0.45
)
dev.off()
# -------------------------------------------------------------------------
# 7. Plot the first diffusion coordinate
# -------------------------------------------------------------------------
png(
"diffusion_toy_4_dc1.png",
width = 1350,
height = 1000,
res = 180
)
plot(
s,
dc[, 1],
type = "o",
pch = 16,
cex = 0.45,
xlab = "True latent sequence s",
ylab = "Diffusion coordinate 1",
main = sprintf(
"DC1 recovers the intrinsic sequence; Spearman(DC1, s) = %.3f",
rho_dc1
)
)
dev.off()
# -------------------------------------------------------------------------
# 8. Optional: use a realistic spectral distance
# -------------------------------------------------------------------------
#
# In CAPIVARA you would usually replace the raw Euclidean distance by a
# noise-weighted distance. For spectra i and j:
#
# d_ij^2 = sum_lambda [
#   w_lambda * (F_i(lambda) - F_j(lambda))^2 /
#   (sigma_i(lambda)^2 + sigma_j(lambda)^2 + floor)
# ]
#
# Then build W_ij = exp(-d_ij^2 / epsilon), followed by the same graph,
# normalization, and eigendecomposition used above.
plot(
s,
dc[, 1],
type = "o",
pch = 16,
cex = 0.45,
xlab = "True latent sequence s",
ylab = "Diffusion coordinate 1",
main = sprintf(
"DC1 recovers the intrinsic sequence; Spearman(DC1, s) = %.3f",
rho_dc1
)
)
plot(
pca_scores[, 1],
pca_scores[, 2],
pch = 16,
cex = 0.45,
xlab = "PC1",
ylab = "PC2",
main = "Local spectral-neighbour graph used by diffusion geometry"
)
for (i in seq_len(n)) {
neighbours <- order(D2[i, ])[seq_len(shown_k)]
for (j in neighbours) {
if (i < j) {
segments(
pca_scores[i, 1],
pca_scores[i, 2],
pca_scores[j, 1],
pca_scores[j, 2]
)
}
}
}
points(
pca_scores[, 1],
pca_scores[, 2],
pch = 16,
cex = 0.45
)
X
dim(X)
plot(X[,1])
plot(X[1,])
plot(X[1,],type="l")
plot(
s,
dc[, 1],
type = "o",
pch = 16,
cex = 0.45,
xlab = "True latent sequence s",
ylab = "Diffusion coordinate 1",
main = sprintf(
"DC1 recovers the intrinsic sequence; Spearman(DC1, s) = %.3f",
rho_dc1
)
)
library(uwot)
set.seed(123)
umap_fit <- uwot::umap(
X,
n_neighbors = 10,
min_dist = 0.05,
n_components = 2,
metric = "euclidean",
init = "spectral",
n_sgd_threads = 1,
verbose = TRUE
)
palette_s <- hcl.colors(100, palette = "Viridis")
point_colors <- palette_s[
1 + floor(s * (length(palette_s) - 1))
]
plot(
umap_fit[, 1],
umap_fit[, 2],
pch = 16,
cex = 0.65,
col = point_colors,
xlab = "UMAP 1",
ylab = "UMAP 2",
main = "UMAP embedding of the toy spectra"
)
# Connect spectra in their true latent order.
ord <- order(s)
lines(
umap_fit[ord, 1],
umap_fit[ord, 2],
col = adjustcolor("black", alpha.f = 0.35)
)
points(
umap_fit[ord, 1],
umap_fit[ord, 2],
pch = 16,
cex = 0.65,
col = point_colors[ord]
)
