# sigcas_clean_visualization_patch.R
# Clean/cartoon-mode simulator for the SigCAS morphology mosaics.
#
# Use after sourcing the previous scripts:
#   source("surface_signature_galaxy_demo.R")
#   source("surface_signature_visual_intuition.R")
#   source("sigcas_morphology_mosaics.R")
#   source("sigcas_clean_visualization_patch.R")
#
# Then run:
#   make_clean_mosaic_files(out_dir = "sigcas_mosaics_clean", n = 180)
#
# This intentionally removes Gaussian read noise and random sky noise so the
# isophote/path idea is visually clean. The original noisy simulator is better
# for stress-testing robustness; this clean simulator is better for talks/papers.
.clean_required <- c("make_grid", "rotate_xy", "elliptical_radius", "rescale01", "gaussian_blur")
.clean_missing <- .clean_required[!vapply(.clean_required, exists, logical(1), mode = "function")]
if (length(.clean_missing) > 0) {
stop(
"Please source surface_signature_galaxy_demo.R first. Missing: ",
paste(.clean_missing, collapse = ", ")
)
}
# sigcas_morphology_mosaics.R
# Mosaic visualizations for the toy surface/isophote-signature morphology experiment.
#
# It compares what the isophote/path-signature view reads against what CAS reads.
