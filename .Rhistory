#   plot_path_reading_mosaic(g)
#   plot_cas_reading_mosaic(g)
#
# No external packages are required.
# -----------------------------------------------------------------------------
# Dependency checks
# -----------------------------------------------------------------------------
.sigcas_required <- c(
"simulate_galaxy", "rescale01", "gaussian_blur", "cas_features",
"surface_signature_graph", "isophote_signature",
"get_isophote_loops", "select_loop", "largest_loop_id",
"plot_isophote_foliation", "plot_ordered_isophote_path",
"plot_cumulative_signature_terms", "plot_isophote_barcode",
"cumulative_loop_geometry"
)
.sigcas_missing <- .sigcas_required[!vapply(.sigcas_required, exists, logical(1), mode = "function")]
if (length(.sigcas_missing) > 0) {
stop(
"Please source surface_signature_galaxy_demo.R and surface_signature_visual_intuition.R first. Missing: ",
paste(.sigcas_missing, collapse = ", ")
)
}
